{
  "expo": {
    "name": "Ingro",
    "slug": "ingro-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f0f23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ingro.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ingro uses your camera to scan barcodes and analyze food ingredients instantly."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f23"
      },
      "package": "com.ingro.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ingro to access your camera to scan product barcodes and analyze ingredients."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "4ab3411a-39ee-421d-98a3-cfebcb52d641"
      }
    },
    "owner": "ipawanktiwari"
  }
}
