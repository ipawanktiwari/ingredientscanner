# Ingro App Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Command Code API Key (required for AI label scanning)
COMMAND_CODE_API_KEY=your_api_key_here

# Open Food Facts (no key needed, just for reference)
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2
